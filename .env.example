# Copy to .env.local and fill in. Never commit real values.
# Neon Postgres pooled connection string (free tier)
DATABASE_URL=
# Random 32+ byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public base URL of the app (http://localhost:3000 locally, the Vercel URL in production)
BETTER_AUTH_URL=
